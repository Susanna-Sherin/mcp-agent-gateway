# MCP Agent Gateway - Environment Configuration Example
# Copy this file to '.env' and customize for local development.
# WARNING: Never commit actual API keys or secrets to version control.

# ==============================================================================
# Server & Application Configuration (Phase 0+)
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ==============================================================================
# Gateway & Policy Engine (Placeholders for Future Phases)
# ==============================================================================
GATEWAY_NAME=mcp-agent-gateway
POLICY_ENFORCEMENT_MODE=permissive  # Options: permissive, strict, audit
POLICY_CONFIG_PATH=config/policies.yaml

# ==============================================================================
# Approval & Audit Workflows (Placeholders for Future Phases)
# ==============================================================================
AUDIT_LOG_DIR=logs/audit
APPROVAL_TIMEOUT_SECONDS=300

# ==============================================================================
# OpenTelemetry Observability (Phase 8)
# OpenTelemetry is disabled by default. Set OTEL_ENABLED=true to enable.
# ==============================================================================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=mcp-agent-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ==============================================================================
# Langfuse Tracing & Observability (Phase 8, Optional)
# Langfuse is disabled by default. Never a policy authority.
# Missing credentials or failure never block execution.
# ==============================================================================
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# GEMINI_API_KEY=your_gemini_api_key_here
# PRESIDIO_ANALYZER_URL=http://localhost:5001
# PRESIDIO_ANONYMIZER_URL=http://localhost:5002
